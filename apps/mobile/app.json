{
  "expo": {
    "name": "CortexAI Agent Hub",
    "slug": "agent-hub",
    "owner": "tukatek",
    "scheme": "cortexai-agent-hub",
    "version": "1.0.4",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FCFCFC",
          "dark": {
            "backgroundColor": "#141414"
          }
        }
      ],
      "expo-router",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": false,
          "microphonePermission": "CortexAI Agent Hub uses the microphone for voice calls with your bots."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "speechRecognitionPermission": "CortexAI Agent Hub turns your speech into messages during voice calls.",
          "microphonePermission": "CortexAI Agent Hub uses the microphone for voice calls with your bots."
        }
      ],
      "expo-localization",
      "@react-native-vector-icons/ionicons",
      "@react-native-vector-icons/material-design-icons",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#F7933B"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "CortexAI Agent Hub uses your photo library so you can attach images to an assistant message.",
          "cameraPermission": "CortexAI Agent Hub uses the camera so you can attach photos to an assistant message.",
          "microphonePermission": "CortexAI Agent Hub uses the microphone for voice calls with your bots."
        }
      ],
      "./plugins/with-share-extension",
      [
        "expo-sharing",
        {
          "ios": {
            "enabled": true,
            "appGroupId": "group.com.tukatek.cortexai.agenthub",
            "activationRule": {
              "supportsText": true,
              "supportsWebUrlWithMaxCount": 1,
              "supportsImageWithMaxCount": 10,
              "supportsFileWithMaxCount": 10
            }
          },
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "text/*",
              "image/*",
              "audio/*",
              "video/mp4",
              "application/pdf",
              "application/json",
              "application/zip"
            ],
            "multipleShareMimeTypes": [
              "image/*",
              "audio/*",
              "video/mp4",
              "application/pdf",
              "application/json",
              "application/zip"
            ]
          }
        }
      ],
      "./plugins/with-worklets-headers",
      "./plugins/with-android-no-gwp-asan",
      "./plugins/with-agent-notifications",
      "./plugins/with-app-intents"
    ],
    "locales": {
      "es": "./locales/es.json",
      "pl": "./locales/pl.json"
    },
    "ios": {
      "bundleIdentifier": "com.tukatek.cortexai.agenthub",
      "buildNumber": "1",
      "supportsTablet": false,
      "icon": "./assets/icon.png",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "CortexAI Agent Hub uses the camera so you can attach photos to an assistant message.",
        "NSPhotoLibraryUsageDescription": "CortexAI Agent Hub uses your photo library so you can attach images to an assistant message.",
        "NSLocalNetworkUsageDescription": "CortexAI Agent Hub connects to a self-hosted CortexAI Agent Hub server on your local network.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "UIBackgroundModes": ["voip", "audio", "remote-notification"],
        "NSUserActivityTypes": ["INSendMessageIntent"]
      },
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true,
        "com.apple.developer.usernotifications.communication": true
      }
    },
    "android": {
      "package": "com.tukatek.cortexai.agenthub",
      "versionCode": 10,
      "softwareKeyboardLayoutMode": "resize",
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/monochrome-icon.png",
        "backgroundColor": "#231F20"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {},
      "supportsRTL": true,
      "eas": {
        "projectId": "c5ac54e3-8365-495d-a638-51b4e0deb329",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "CortexAiAgentHubWidgets",
                  "bundleIdentifier": "com.tukatek.cortexai.agenthub.widgets"
                },
                {
                  "targetName": "expo-sharing-extension",
                  "bundleIdentifier": "com.tukatek.cortexai.agenthub.expo-sharing-extension",
                  "entitlements": {
                    "com.apple.security.application-groups": ["group.com.tukatek.cortexai.agenthub"]
                  }
                },
                {
                  "targetName": "AgentNotifications",
                  "bundleIdentifier": "com.tukatek.cortexai.agenthub.notifications",
                  "entitlements": {
                    "com.apple.developer.usernotifications.communication": true
                  }
                }
              ]
            }
          }
        }
      }
    },
    "updates": {
      "url": "https://u.expo.dev/c5ac54e3-8365-495d-a638-51b4e0deb329"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
