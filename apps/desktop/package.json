{
  "name": "@cortexai-agent-hub/desktop",
  "productName": "CortexAI Agent Hub",
  "version": "0.3.1",
  "author": {
    "name": "CortexAI Agent Hub"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "pnpm build && electron .",
    "build": "pnpm check && node scripts/build.mjs && node scripts/copy-static.mjs",
    "pack": "pnpm --filter @cortexai-agent-hub/web build && pnpm build && electron-builder --mac --win --linux",
    "pack:dir": "pnpm --filter @cortexai-agent-hub/web build && pnpm build && electron-builder --dir",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ../.. apps/desktop/src",
    "test:e2e": "pnpm build && playwright test --config e2e/playwright.config.ts",
    "release": "pnpm --filter @cortexai-agent-hub/web build && pnpm build && electron-builder --publish never"
  },
  "dependencies": {
    "@cortexai-agent-hub/contracts": "workspace:*",
    "electron-updater": "6.8.9",
    "koffi": "3.3.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@cortexai-agent-hub/adapters": "workspace:*",
    "@cortexai-agent-hub/ui-tokens": "workspace:*",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  },
  "build": {
    "appId": "com.tukatek.cortexai.agenthub.desktop",
    "directories": {
      "output": "out",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web"
      },
      {
        "from": "../../infra/compose/docker-compose.images.yml",
        "to": "stack/docker-compose.images.yml"
      },
      {
        "from": "../../infra/compose/.env.images.example",
        "to": "stack/.env.images.example"
      }
    ],
    "extraMetadata": {
      "name": "cortexai-agent-hub",
      "main": "dist/main.js"
    },
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity",
      "x64ArchFiles": "**/node_modules/@koromix/koffi-darwin-*/darwin_*/koffi.node",
      "target": [
        "dmg",
        "zip"
      ],
      "notarize": true
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ],
      "verifyUpdateCodeSignature": true
    },
    "linux": {
      "executableName": "cortexai-agent-hub",
      "icon": "assets/icon.png",
      "target": [
        "AppImage"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "TukaTek",
        "repo": "agent-hub"
      }
    ]
  }
}
