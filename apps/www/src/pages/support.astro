---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { fetchGithubStars, formatStarCount } from "../github";
import BaseLayout from "../layouts/BaseLayout.astro";
import { CORTEXAI_CONTACT_URL, DOCS_URL, GITHUB_URL, SECURITY_URL } from "../site";

const stars = await fetchGithubStars();
const starsLabel = stars === null ? "Star" : formatStarCount(stars);
---

<BaseLayout title="Support · CortexAI Agent Hub" description="Get help with the CortexAI Agent Hub app and self-hosted CortexAI Agent Hub.">
  <div class="container">
    <Header starsLabel={starsLabel} />
    <main id="main" class="privacy-copy">
      <h1>CortexAI Agent Hub support</h1>
      <p>
        For CortexAI product or account help, <a href={CORTEXAI_CONTACT_URL}>contact CortexAI</a>.
        Do not send passwords, API keys, access tokens, or other secrets.
      </p>
      <h2>Security</h2>
      <p>
        Report vulnerabilities through <a href={SECURITY_URL}>private vulnerability reporting</a>, never a public issue.
      </p>
      <h2>Self-hosted CortexAI Agent Hub</h2>
      <p>
        Start with the <a href={DOCS_URL}>self-hosting guide</a>. For reproducible bugs or feature requests,
        open an issue in the <a href={`${GITHUB_URL}/issues`}>CortexAI Agent Hub GitHub repository</a>.
      </p>
      <h2>Account deletion</h2>
      <p>
        In the mobile app, open <strong>Account</strong>, enter your current password under{" "}
        <strong>Delete account</strong>, and confirm. This permanently deletes the hosted account and its
        associated personal Space data.
      </p>
    </main>
    <Footer />
  </div>
</BaseLayout>
