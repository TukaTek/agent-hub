---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { fetchGithubStars, formatStarCount } from "../github";
import BaseLayout from "../layouts/BaseLayout.astro";
import { CORTEXAI_CONTACT_URL, DOCS_URL, GITHUB_URL } from "../site";

const stars = await fetchGithubStars();
const starsLabel = stars === null ? "Star" : formatStarCount(stars);
---

<BaseLayout
  title="About · CortexAI Agent Hub"
  description="How CortexAI Agent Hub gives people persistent, controllable AI assistants that can do real work."
>
  <div class="container">
    <Header starsLabel={starsLabel} />
    <main id="main" class="privacy-copy">
      <h1>About CortexAI Agent Hub</h1>
      <p>
        CortexAI Agent Hub provides persistent AI assistants that can use a browser and shell,
        remember the work around a job, run routines on a schedule, and ask for approval when they reach a
        boundary. It is designed for practical operational work rather than one-off chat.
      </p>
      <h2>Why we are building it</h2>
      <p>
        Useful agents should be understandable and controllable by the people who run them. CortexAI Agent Hub keeps
        routines in readable Markdown, supports multiple model providers, records actions in an audit log, and
        lets operators keep model keys, browser sessions, and deployment infrastructure under their own
        control. The same assistants and routines work across the web, desktop, and mobile clients.
      </p>
      <h2>Open by default</h2>
      <p>
        CortexAI Agent Hub is released under the Apache-2.0 license. The project accepts
        public issues and contributions on <a href={GITHUB_URL}>GitHub</a>. To run CortexAI Agent Hub on your own
        infrastructure, start with the <a href={DOCS_URL}>self-hosting guide</a>. For product or account help,
        <a href={CORTEXAI_CONTACT_URL}>contact CortexAI</a>.
      </p>
    </main>
    <Footer />
  </div>
</BaseLayout>
