{
  "contractVersion": 2,
  "transport": "hub-tenant-auth",
  "supersedes": "agent-hub-auth.v1.json",
  "product": { "slug": "cortexai-agent-hub", "code": "CAIA" },
  "endpoints": {
    "lookup": "/api/tenant-auth/lookup",
    "login": "/api/tenant-auth/login",
    "refresh": "/api/tenant-auth/refresh",
    "revoke": "/api/tenant-auth/revoke",
    "session": "/api/tenant-auth/session",
    "config": "/api/tenant-auth/config?product=cortexai-agent-hub",
    "serviceToken": "/api/agent-hub/service-token",
    "ssoStart": "/api/tenant-auth/sso-start",
    "ssoExchange": "/api/agent-hub/sso-exchange"
  },
  "sso": {
    "sharedFixture": "agent-hub-web-sso.v1.json",
    "returnChannel": "agent-hub-web",
    "callbackPath": "/api/auth/hub/sso/callback",
    "continueRequest": { "email": "user@example.test" },
    "continueResponses": {
      "password": { "next": "password" },
      "redirect": {
        "next": "redirect",
        "url": "https://login.microsoftonline.com/synthetic-tenant/oauth2/v2.0/authorize?state=opaque"
      },
      "ssoOff": { "next": "sso_unavailable" }
    },
    "serviceTokenRequest": {
      "apiId": "fixture-api-id",
      "secret": "synthetic-service-secret",
      "tenantId": "fixture-tenant"
    },
    "serviceTokenResponse": {
      "token": "synthetic.service-token.not-a-jwt",
      "tokenType": "Bearer",
      "expiresIn": 300
    },
    "serviceTokenErrors": [
      { "status": 400, "error": "invalid_request" },
      { "status": 401, "error": "invalid_credentials" },
      { "status": 429 },
      { "status": 503, "error": "configuration_unavailable" }
    ],
    "callbackErrors": ["sso_expired", "sso_failed"]
  },
  "lookupRequest": { "email": "user@example.test" },
  "lookupResponse": {
    "tenantId": "fixture-tenant",
    "tenantName": "Fixture",
    "tenantSlug": "fixture",
    "idpType": "native"
  },
  "loginRequest": { "email": "user@example.test", "password": "synthetic-test-password" },
  "sessionResponse": {
    "success": true,
    "user": {
      "id": "fixture-user",
      "tenantId": "fixture-tenant",
      "email": "user@example.test",
      "displayName": "Fixture User",
      "role": "user"
    },
    "accessToken": "synthetic-opaque-access-token",
    "accessTokenExpiresAt": "2030-01-02T00:00:00.000Z",
    "refreshToken": "synthetic-opaque-refresh-token",
    "refreshTokenExpiresAt": "2030-01-31T00:00:00.000Z",
    "returnUrl": null,
    "products": [
      { "id": "cortexai-agent-hub", "name": "CortexAI Agent Hub", "enabled": true, "role": "user" }
    ]
  },
  "verification": {
    "identity": ["user.tenantId", "user.id"],
    "entitlement": "products entry with id=cortexai-agent-hub and enabled=true, followed by a successful product config request",
    "tokenFormat": "opaque",
    "jwtVerification": false,
    "oauthClientRequired": false,
    "tenantDiscovery": "lookup; confirm returned tenantId equals authenticated user.tenantId",
    "refreshIdentity": "must equal original authenticated tenant and user",
    "configHandling": "server-side only; may contain provider credentials; do not return to the browser as authentication state",
    "revocation": "revalidate product config before authorizing protected work; do not cache entitlement until access-token expiry",
    "sessionBinding": "when /session returns product or deploymentId, they must equal cortexai-agent-hub and HUB_DEPLOYMENT_ID"
  },
  "configDenied": { "status": 403, "error": "access_denied" }
}
