[Unit]
Description=Create and verify a CortexAI Agent Hub production backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/cortexai-agent-hub/backup.env
ExecStart=/usr/local/sbin/cortexai-agent-hub-backup
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/backups
