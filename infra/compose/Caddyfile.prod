{
	servers {
		# A same-host front proxy such as Tailscale serve reaches Caddy from loopback or the Docker
		# bridge. Its X-Forwarded-For names the real client; every other peer's value is replaced.
		trusted_proxies static 127.0.0.0/8 ::1 172.16.0.0/12
		trusted_proxies_strict
	}
}

# JSON access logs on stdout. Caddy already masks Authorization and Cookie; these filters also
# drop them, Set-Cookie, Referer (a page URL can hold a reset token), and the one-time tokens
# and screen capabilities the app carries in URLs.
(access_log) {
	log {
		output stdout
		format filter {
			wrap json
			request>headers>Authorization delete
			request>headers>Proxy-Authorization delete
			request>headers>Cookie delete
			request>headers>Referer delete
			resp_headers>Set-Cookie delete
			# Native sign-in redirects carry the session cookie in the app callback URL.
			resp_headers>Location delete
			request>uri regexp "(/reset-password/|/novnc/session/[a-z]+/)[^/?#&]*|([?&](?:token|_token|code|state|ticket|access_token|id_token|hub\.verify_token|path)=)[^&#]*" "${1}${2}REDACTED"
		}
	}
}

(deploy_retry) {
	lb_try_duration 10s
	lb_try_interval 250ms
}

# The API rate-limits sign-in per address and trusts only a single X-Forwarded-For value.
(forward_client_ip) {
	header_up X-Forwarded-For {client_ip}
}

{$CORTEXAI_AGENT_HUB_HOST:app.example.com} {
	import access_log
	encode zstd gzip

	# A localhost trial must not pin HTTPS onto every local dev server.
	@hsts not host localhost 127.0.0.1
	header @hsts Strict-Transport-Security "max-age=31536000"
	# SAMEORIGIN still lets the app frame its own /novnc/ screen.
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
	}

	handle /health {
		reverse_proxy api:3100 {
			import deploy_retry
		}
	}

	handle /api/* {
		reverse_proxy api:3100 {
			import deploy_retry
			import forward_client_ip
		}
	}

	handle /rpc/* {
		reverse_proxy api:3100 {
			import deploy_retry
			import forward_client_ip
		}
	}

	handle {
		reverse_proxy web:5173 {
			import deploy_retry
		}
	}
}
